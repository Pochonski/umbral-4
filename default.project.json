        "StreamingEnabled": false
      },
      "UmbralWorld": { "$path": "map/EstacionDeRelevo.rbxmx" }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 14.2,
        "Brightness": 2.4,
