        "OutdoorAmbient": [0.53, 0.59, 0.64]
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "UmbralShared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "UmbralServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "UmbralClient": { "$path": "src/client" }
      }
    }
